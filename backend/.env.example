PORT=3000
NODE_ENV=development

# Conexión local (XAMPP / MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=secure_net
DB_SSL=false

# TiDB Cloud / Render: usar el host público, puerto 4000 y TLS.
# DB_HOST=gateway*.*.tidbcloud.com
# DB_PORT=4000
# DB_USER=
# DB_PASSWORD=
# DB_NAME=secure_net
# DB_SSL=true
# DATABASE_URL=mysql://USUARIO:PASSWORD@HOST:4000/secure_net

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*
